{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "accessWidener": "spatialloop.accesswidener",
  "entrypoints": {
    "main": ["cc.sighs.spatialloop.SpatialLoopFabric"],
    "client": ["cc.sighs.spatialloop.client.SpatialLoopFabricClient"]
  },
  "mixins": [
    {
      "config": "spatialloop.mixins.json",
      "environment": "*"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
